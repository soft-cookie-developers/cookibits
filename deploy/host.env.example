# Copy to ~/.config/cookibits/host.env on the serving machine.

# Script that execs vLLM in the foreground with this host's flags. It must not
# background itself (no nohup, no &): systemd supervises the process.
COOKIBITS_SERVE_SCRIPT=/path/to/serve.sh
# Virtual environment where the gateway is installed.
COOKIBITS_GATEWAY_VENV=/path/to/gateway-venv
# Gateway config file (copied from gateway/config.example.toml).
COOKIBITS_GATEWAY_CONFIG=/path/to/config.toml
