# Copy to .env next to compose.yaml. Never commit .env.

# Where chats, accounts and settings are stored on the host.
COOKIBITS_WEBUI_DATA=/path/to/webui-data
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Create with: cookibits-gateway keys add open-webui
COOKIBITS_WEBUI_GATEWAY_KEY=
# The address people use to open the UI, e.g. https://<host>.<tailnet>.ts.net:8481
COOKIBITS_WEBUI_URL=
# Optional custom name (50 users or fewer only). Leave unset otherwise.
# COOKIBITS_WEBUI_NAME=
# Set to false to close self sign-up once everyone has an account.
COOKIBITS_WEBUI_SIGNUP=true
